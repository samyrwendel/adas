#!/usr/bin/env bash
# adas — linha de comando do ADAS (instalada em ~/.local/bin/adas pelo install.sh).
#   adas juiz status|testar|configurar [--auto]|link [--host IP]   chave do juiz sem passar pelo chat (DA-479)
#   adas nivel [mudancas]                                         termostato do ADAS-JIT (DA-468)
#   adas versao | adas update                                     versão instalada / atualização segura
J="$(dirname "$(readlink -f "$0")")/jit"
case "${1:-}" in
  juiz) shift; exec python3 "$J/juiz_prov.py" "${@:-status}" ;;
  nivel) shift; exec python3 "$J/termostato.py" "$@" ;;
  versao) cat "$HOME/.claude/adas/VERSION" 2>/dev/null || cat "$J/../../VERSION" ;;
  update) shift; exec bash "$J/../update.sh" "$@" ;;
  *) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
